---
import Tag from '../../../views/Tag.astro';
import { postsIn } from '../../../content-api';
import { tagCounts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await postsIn('de');
  return tagCounts(posts).map((t) => ({ params: { tag: t.slug } }));
}

const { tag } = Astro.params;
---

<Tag locale="de" tag={tag as string} />
