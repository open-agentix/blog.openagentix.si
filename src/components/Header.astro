---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import logo from '../assets/logo-mark.svg?raw';
import type { Locale } from '../i18n/config';
import { paths } from '../i18n/paths';
import { getDictionary } from '../i18n/ui';
import { projectLinks } from '../lib/links';
import { GITHUB_ORG } from '../project';

interface Props {
  locale: Locale;
  /** Per-locale URL of the current page, for the language switch. */
  langUrls: Partial<Record<Locale, string>>;
}

const { locale, langUrls } = Astro.props;
const t = getDictionary(locale);
const home = paths.home(locale);
const links = projectLinks(locale);
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href={home} aria-label={t.blogName}>
      <span class="mark" set:html={logo} />
      <span class="word" aria-hidden="true">
        <span class="name">open<span class="blue">agentix</span><span class="dot" aria-hidden="true">.</span></span>
        <span class="sub">{t.superIntelligence}</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t.nav.label} data-open="false">
      <ul>
        {links.map((l) => <li><a href={l.href}>{t.nav[l.id]}</a></li>)}
        <li><a href={home} aria-current="page">{t.nav.blog}</a></li>
      </ul>
      <div class="nav-extra">
        <LangSwitch locale={locale} urls={langUrls} />
      </div>
    </nav>

    <div class="actions">
      <div class="lang-desktop"><LangSwitch locale={locale} urls={langUrls} compact /></div>
      <button class="icon-btn" type="button" data-theme-toggle aria-pressed="false" aria-label={t.theme.toggle}>
        <Icon name="sun" class="i-sun" size={18} />
        <Icon name="moon" class="i-moon" size={18} />
      </button>
      <a class="icon-btn" href={GITHUB_ORG} aria-label={t.nav.github}>
        <Icon name="github" size={18} />
      </a>
      <button class="icon-btn menu-btn" type="button" data-menu-button aria-controls="site-nav" aria-expanded="false" aria-label={t.nav.menu}>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.125rem;
  }

  .mark :global(svg) {
    width: 30px;
    height: 30px;
  }

  .word {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .blue {
    color: var(--brand-blue);
  }

  /* Decorative full stop after the name: same box as the wordmark, purple like the tagline. */
  .dot {
    color: var(--brand-muted-purple);
  }

  /* Understated line under the name: small, muted purple, never louder than the navigation. */
  .sub {
    margin-top: 0.15rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--brand-muted-purple);
  }

  .nav {
    flex: 1;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav a[aria-current='page'] {
    background: rgb(127 127 127 / 0.14);
  }

  .nav-extra {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--text);
    background: rgb(127 127 127 / 0.12);
  }

  .menu-btn {
    display: none;
  }

  @media (max-width: 760px) {
    .nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      padding: 1rem var(--gutter) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      display: none;
    }

    .nav[data-open='true'] {
      display: block;
    }

    .nav ul {
      flex-direction: column;
    }

    .nav a {
      font-size: 1.125rem;
      padding: 0.75rem 0;
    }

    .nav a[aria-current='page'] {
      background: none;
    }

    .nav-extra {
      display: block;
      margin-top: 1rem;
    }

    .lang-desktop {
      display: none;
    }

    .menu-btn {
      display: inline-grid;
    }
  }
</style>
